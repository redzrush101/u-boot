# Samsung Galaxy A70 (a70q): make qcom_defconfig qcom-phone.config samsung-a70q.config
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/samsung-a70q.env"
# Volume Up is a gpio-keys PMIC GPIO; Volume Down and Power are PON keys.
CONFIG_BUTTON_GPIO=y
# The pmOS disk image lives inside userdata and is reached through blkmap.
CONFIG_BLKMAP=y
CONFIG_CMD_SETEXPR_FMT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
# Fastboot flashes UFS LUN 0 (boot, recovery, userdata, ...).
# CONFIG_FASTBOOT_FLASH_MMC is not set
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0
# Reboot to recovery/fastbootd through the bootloader control block in misc.
CONFIG_CMD_BCB=y
CONFIG_CMD_ABOOTIMG=y
