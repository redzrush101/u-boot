/*
 * Galaxy A70. Standard boot scans microSD, then the userdata partition
 * (a root filesystem, or a disk image as postmarketOS installs it), then the
 * UFS LUNs, and boots the first extlinux.conf, boot script or EFI loader it
 * finds. Hold Volume Down while U-Boot starts for the menu.
 */
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

boot_targets=mmc blkmap scsi
fastboot=fastboot -l $fastboot_addr_r usb 0

/*
 * blkmap exposes the disk image in userdata (UFS LUN 0) as its own disk.
 * blkmap's source block is decimal, part start prints hex.
 */
userdata_map=if blkmap get userdata dev userdata_dev; then true; else \
	part start scsi 0 userdata ud_start && \
	part size scsi 0 userdata ud_size && \
	setexpr ud_start fmt %d 0x${ud_start} && \
	blkmap create userdata && \
	blkmap map userdata 0 ${ud_size} linear scsi 0 ${ud_start} && \
	blkmap get userdata dev userdata_dev; fi

/*
 * One-shot fastboot from the OS: "touch /boot/u-boot-fastboot; reboot" on
 * the first partition of the userdata image (postmarketOS /boot).
 */
fastboot_flag=if test -e blkmap ${userdata_dev}:1 /u-boot-fastboot; then \
	fatrm blkmap ${userdata_dev}:1 /u-boot-fastboot; \
	setenv bootretry -1; run fastboot; fi

/*
 * Hunt (not "scsi scan"): a later hunt would rescan the bus and leave the
 * blkmap pointing at removed block devices.
 */
preboot=bootdev hunt scsi; run userdata_map; run fastboot_flag

/* A full scan of LUN 0 stops after 30 partitions, before userdata. */
userdata_boot=part number scsi 0 userdata ud_part && \
	bootflow scan -lb ufs_scsi.id0lun0.bootdev:${ud_part}

/* The stock bootloader reads misc: recovery, or recovery's fastbootd. */
reboot_recovery=bcb load scsi 0 misc && bcb set command boot-recovery && \
	bcb set recovery recovery && bcb store && reset
reboot_fastbootd=bcb load scsi 0 misc && bcb set command boot-recovery && \
	bcb set recovery recovery:--fastboot: && bcb store && reset

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

/* After a failed boot, show the menu (and keep reopening it) instead of a shell. */
/* One label at a time: a bootdev failing to probe ends a full scan. */
boot_os=bootflow scan -lb mmc; run userdata_boot; bootflow scan -lb blkmap; \
	bootflow scan -lb scsi
bootcmd=run boot_os; pause; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=Boot first OS found=run boot_os; pause
bootmenu_1=Choose OS=bootflow scan; bootflow menu; pause
bootmenu_2=Fastboot (UFS LUN 0)=echo "Press any key to exit fastboot mode"; run fastboot
bootmenu_3=USB mass storage: userdata image=run userdata_map && echo "Press any key to exit UMS mode" && ums 0 blkmap ${userdata_dev}
bootmenu_4=USB mass storage: UFS LUN 0=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_5=USB mass storage: microSD=echo "Press any key to exit UMS mode"; ums 0 mmc 0
bootmenu_6=Enable serial console gadget=run serial_gadget
bootmenu_7=Reboot to recovery=run reboot_recovery
bootmenu_8=Reboot to recovery fastbootd=run reboot_fastbootd
bootmenu_9=Drop to shell=setenv bootretry -1
bootmenu_10=Reset device=reset
bootmenu_11=Power off=poweroff
bootmenu_12=Dump environment=printenv; pause

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
